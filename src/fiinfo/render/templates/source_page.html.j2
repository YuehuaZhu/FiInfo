<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FiInfo · {{ kind }} · {{ date }}</title>
<style>
:root {
  --bg: #fafafa; --bg-card: #fff; --bg-elevated: #f4f5f7;
  --text: #1a1a1a; --text-secondary: #555; --text-muted: #888;
  --border: #e6e6e8; --link: #1f6feb; --link-hover: #0f5fdb;
  --shadow-sm: 0 1px 2px rgba(0,0,0,.04), 0 1px 4px rgba(0,0,0,.04);
  --radius: 10px; --radius-sm: 6px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1116; --bg-card: #161b22; --bg-elevated: #1c222b;
    --text: #e6edf3; --text-secondary: #9fa9b8; --text-muted: #6e7681;
    --border: #2b313a; --link: #58a6ff; --link-hover: #79b8ff;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.3);
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
               "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  background: var(--bg); color: var(--text); line-height: 1.7;
  margin: 0; padding: 0; -webkit-font-smoothing: antialiased;
}
.wrap { max-width: 920px; margin: 0 auto; padding: 1.5rem 1.2rem 5rem; }

.back {
  display: inline-flex; align-items: center; gap: .3rem;
  color: var(--text-muted); text-decoration: none;
  font-size: .88rem; margin-bottom: .8rem;
}
.back:hover { color: var(--link); }

.hero {
  padding: 1rem 0 1.2rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 1.2rem;
}
.hero h1 {
  font-size: clamp(1.5rem, 4vw, 2rem);
  margin: 0 0 .3rem;
  letter-spacing: -.02em;
  font-weight: 700;
}
.hero .meta {
  color: var(--text-muted); font-size: .9rem;
}

.kind-badge {
  display: inline-block; padding: .3rem .8rem;
  border-radius: 100px; font-size: .85rem; font-weight: 600;
  margin-right: .4rem;
}
.src-twitter           { background: color-mix(in srgb, #1da1f2 18%, transparent); color: #1da1f2; }
.src-defillama_tvl     { background: color-mix(in srgb, #7c3aed 18%, transparent); color: #7c3aed; }
.src-defillama_hacks   { background: color-mix(in srgb, #ef4444 18%, transparent); color: #ef4444; }
.src-defillama_raises  { background: color-mix(in srgb, #10b981 18%, transparent); color: #10b981; }
.src-coingecko_trending{ background: color-mix(in srgb, #8dc647 18%, transparent); color: #6da636; }
.src-snapshot          { background: color-mix(in srgb, #384bff 18%, transparent); color: #384bff; }
.src-github_trending   { background: color-mix(in srgb, #6e7681 25%, transparent); color: var(--text); }
.src-rss               { background: color-mix(in srgb, #ee802f 18%, transparent); color: #d96f1c; }
.src-reddit            { background: color-mix(in srgb, #ff4500 18%, transparent); color: #ff4500; }
.src-cryptopanic       { background: color-mix(in srgb, #14b8a6 18%, transparent); color: #14b8a6; }

.signal-list { display: grid; gap: .7rem; }
.signal {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: .9rem 1rem;
  box-shadow: var(--shadow-sm);
}
.signal-head {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 1rem; font-size: .82rem; color: var(--text-muted);
  margin-bottom: .4rem; flex-wrap: wrap;
}
.signal-head .author {
  font-weight: 700; color: var(--text-secondary); font-size: .95rem;
}
.signal-head .when { white-space: nowrap; }
.signal-head .score {
  padding: .1rem .5rem;
  background: var(--bg-elevated);
  border-radius: 4px;
  font-size: .72rem;
  color: var(--text-secondary);
  font-weight: 600;
}
.signal-text {
  color: var(--text);
  word-wrap: break-word; overflow-wrap: break-word;
  white-space: pre-wrap;
}
.signal-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: .5rem; font-size: .78rem; color: var(--text-muted);
}
.signal-foot a {
  color: var(--text-muted); text-decoration: none;
}
.signal-foot a:hover { color: var(--link); }
.engagement { display: flex; gap: .6rem; }

.footer {
  margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
  text-align: center; color: var(--text-muted); font-size: .8rem;
}

@media (max-width: 640px) {
  .wrap { padding: 1rem .9rem 4rem; }
  .signal { padding: .7rem .8rem; }
}
</style>
</head>
<body>
<div class="wrap">

<a class="back" href="{{ back_to_index }}">← 返回主简报</a>

<header class="hero">
  <h1><span class="kind-badge src-{{ kind }}">{{ kind }}</span></h1>
  <div class="meta">{{ date }} · 共 {{ total }} 条信号</div>
</header>

<div class="signal-list">
{% for t in signals %}
<article class="signal">
  <div class="signal-head">
    <span class="author">@{{ t.kol_handle }}</span>
    {% if t.posted_at %}<span class="when">{{ t.posted_at[:16] }}</span>{% endif %}
    <span class="score">score {{ t.score|int }}</span>
  </div>
  <div class="signal-text">{{ t.text }}</div>
  <div class="signal-foot">
    <span class="engagement">
      {% if t.likes %}<span>❤ {{ t.likes }}</span>{% endif %}
      {% if t.retweets %}<span>🔁 {{ t.retweets }}</span>{% endif %}
    </span>
    <a href="{{ t.url }}" target="_blank" rel="noopener">原文 ↗</a>
  </div>
</article>
{% endfor %}
</div>

<footer class="footer">
  FiInfo · {{ kind }} 频道 · {{ date }} · <a href="{{ back_to_index }}">返回主页</a>
</footer>

</div>
</body>
</html>

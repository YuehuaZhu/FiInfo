# === LLM ===
ANTHROPIC_API_KEY=
# 代理网关替代方案(二者择一):
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6
# 豆包(火山方舟,OpenAI 兼容,200 万 token/天免费)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-pro-32k
# 千问(阿里 DashScope, OpenAI 兼容,最高优先级)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
# === Runtime ===
FIINFO_DATA_DIR=./data
FIINFO_TZ=Asia/Shanghai
FIINFO_DAILY_LIMIT_PER_CATEGORY=30
FIINFO_TOP_KOL_RATIO=0.25
